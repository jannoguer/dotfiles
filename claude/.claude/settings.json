{
    "awaySummaryEnabled": false,
    "env": {
        "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "1",
        "CLAUDE_CODE_DISABLE_MOUSE": "1",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    },
    "model": "opus",
    "permissions": {
        "allow": [
            "Skill",
            "WebFetch",
            "WebSearch"
        ],
        "defaultMode": "auto"
    },
    "remoteControlAtStartup": false,
    "statusLine": {
        "command": "~/.claude/statusline.sh",
        "refreshInterval": 5,
        "type": "command"
    },
    "theme": "dark"
}
