{
  "awaySummaryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
  },
  "model": "opus",
  "remoteControlAtStartup": false,
  "theme": "dark",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Skill",
      "WebFetch",
      "WebSearch"
    ]
  },
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 5,
    "type": "command"
  }
}
